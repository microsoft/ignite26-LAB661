flowchart LR
    user([Engineer]):::actor
    subgraph agent["Contoso DevBot (agent under test)"]
        direction TB
        chat["chat(message)"]:::node
        tools["simulated tools<br/>run_command · read_file · http_post"]:::node
        chat --- tools
    end
    policy[["ACS policy<br/>manifest + Rego"]]:::acs
    guard{"guard_target<br/>evaluate at output"}:::acs
    blocked([request refused]):::danger

    user -->|request| chat
    chat -->|candidate response| guard
    policy -.governs.-> guard
    guard -->|safe| user
    guard -->|unsafe| blocked

    classDef actor fill:#132132,stroke:#4c8dff,stroke-width:1.5px,color:#cfe0ff
