# infra/setup.sh creates `.env` for the live More labs from this template
# (instructions/self-paced/more/lab-0-assert-skill.md and lab-1-live-run.md).
# The offline core needs none of these.
#
# No API keys: DevBot and ASSERT sign in with your Azure identity (`az login`).
# .env is gitignored. Never commit it.

# Route DevBot through a real model instead of the deterministic offline stand-in.
DEVBOT_MODE=offline
# DEVBOT_MODE=live
DEVBOT_MODEL=azure/gpt-5.4-mini

# Your Foundry resource endpoint. infra/setup.sh fills this value in .env.
AZURE_API_BASE=
AZURE_API_VERSION=2025-04-01-preview

# Tell ASSERT to use Entra ID (az login) instead of looking for AZURE_API_KEY.
ASSERT_AZURE_USE_AAD=1

# Model the live ASSERT eval uses to generate tests and to judge.
ASSERT_MODEL=azure/gpt-5.4-mini

# Application Insights connection string for Foundry tracing. setup.sh writes it
# privately into .env. Treat it as a credential and never commit it.
APPLICATIONINSIGHTS_CONNECTION_STRING=
