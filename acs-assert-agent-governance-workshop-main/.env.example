# Copy to `.env` and fill in ONLY for the optional live track (workshop/more/lab-live-run.md).
# The offline core of the workshop needs none of these.
#
# Never commit a real key. .env is gitignored.

# Route DevBot through a real model instead of the deterministic offline stand-in.
DEVBOT_MODE=offline
# DEVBOT_MODE=live
DEVBOT_MODEL=azure/gpt-5.4-mini

# Provider credentials used by ASSERT (LiteLLM) for a real `assert-ai run`
# and by DevBot live mode. Example shown for Azure OpenAI.
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2025-04-01-preview

# Model the live ASSERT eval uses to generate tests and to judge.
ASSERT_MODEL=azure/gpt-5.4-mini

# Application Insights connection string for Foundry tracing. setup.sh prints the
# command that fetches it. Treat it as a credential and never commit it.
APPLICATIONINSIGHTS_CONNECTION_STRING=
